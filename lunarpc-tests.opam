# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Tests and end-to-end examples for lunarpc"
maintainer: ["Mathieu Barbin <opensource@mbarbin.org>"]
authors: ["Mathieu Barbin"]
license: "MIT"
homepage: "https://github.com/mbarbin/lunarpc"
doc: "https://mbarbin.github.io/lunarpc/"
bug-reports: "https://github.com/mbarbin/lunarpc/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2"}
  "base" {>= "v0.17"}
  "cmdlang" {>= "0.0.11"}
  "cmdlang-cmdliner-err-runner" {>= "0.0.17"}
  "dune-build-info" {>= "3.20"}
  "jsonschema" {>= "0.1.0"}
  "lunarpc" {= version}
  "lunarpc-client" {= version}
  "lunarpc-discovery" {= version}
  "lunarpc-quickcheck" {= version}
  "lunarpc-server" {= version}
  "lunarpc-stdlib" {= version}
  "lunarpc-test-harness" {= version}
  "mdexp" {>= "0.0.1"}
  "nofunc-stdhtbl" {>= "0.1.0"}
  "parsexp" {>= "v0.17"}
  "pp" {>= "2.0.0"}
  "pplumbing-err" {>= "0.0.17"}
  "pplumbing-log" {>= "0.0.17"}
  "pplumbing-log-cli" {>= "0.0.17"}
  "pplumbing-pp-tty" {>= "0.0.17"}
  "ppx_expect" {>= "v0.17"}
  "ppxlib" {>= "0.33"}
  "tiny_httpd" {>= "0.19"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mbarbin/lunarpc.git"
x-maintenance-intent: ["(latest)"]
