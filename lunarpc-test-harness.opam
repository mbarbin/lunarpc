# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A library to help writing tests for lunarpc applications"
maintainer: ["Mathieu Barbin <opensource@mbarbin.org>"]
authors: ["Mathieu Barbin"]
license: "MIT"
homepage: "https://github.com/mbarbin/lunarpc"
doc: "https://mbarbin.github.io/lunarpc/"
bug-reports: "https://github.com/mbarbin/lunarpc/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.3"}
  "lunarpc-client" {= version}
  "lunarpc-discovery" {= version}
  "lunarpc-stdlib" {= version}
  "nofunc-stdset" {>= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mbarbin/lunarpc.git"
x-maintenance-intent: ["(latest)"]
